generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Job {
  id                 String   @id
  source             String
  slug               String
  label              String
  title              String
  location           String?
  country            String?
  region             String?
  city               String?
  remote             Boolean  @default(false)
  locationConfidence String   @default("none")
  url                String
  department         String?
  createdAt          String?
  firstSeenAt        DateTime @default(now())
  isNew              Boolean  @default(true)
  isActive           Boolean  @default(true)
  category           String   @default("so")
}

// Daily record for boards tracked with `trackAll` (currently Adobe): one row per local calendar day.
model DailyStat {
  date       String    // local calendar date, YYYY-MM-DD
  slug       String
  category   String
  posted     Int       @default(0) // known jobs whose posted date is this day (still open or since closed)
  discovered Int       @default(0) // jobs first found by scans run on this day
  active     Int?      // open jobs after the last scan this day; null if no scan ran that day
  scannedAt  DateTime? // time of the last successful scan this day

  @@id([date, slug, category])
}

model ScanRun {
  id          Int      @id @default(autoincrement())
  ranAt       DateTime @default(now())
  isBaseline  Boolean  @default(false)
  newJobCount Int      @default(0)
  totalJobs   Int      @default(0)
  error       String?
}
